AWS_REGION=us-east-1
S3_BUCKET=your-project-bucket-name
S3_PREFIX=financial-reports
S3_ENABLED=true
CHAT_MODEL_ID=
EMBEDDING_MODEL_ID=
LOCAL_CHAT_MODEL_ID=google/flan-t5-small
WEB_SEARCH_ENABLED=true
WEB_SEARCH_REGION=in-en
WEB_SEARCH_BACKEND=auto
WEB_SEARCH_TIMEOUT_SECONDS=10

# Do not add AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or
# AWS_SESSION_TOKEN here. Use an AWS CLI profile locally and the EC2 IAM role
# in production.
